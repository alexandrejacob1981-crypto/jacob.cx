---
import { site } from '../data/site';
import { partoo } from '../data/partoo';

/**
 * Bouton de contact rapide.
 *
 * Deux modes, selon que le script Partoo est renseigné ou non :
 *
 *  — `partoo.scriptUrl` rempli  : le bouton charge le chat Partoo AU CLIC.
 *  — `partoo.scriptUrl` vide    : le bouton ouvre un petit panneau maison
 *                                 (appeler, SMS, courriel). Aucun tiers,
 *                                 aucun cookie, et ça marche tout de suite.
 *
 * Dans les deux cas, rien n'est chargé tant que le visiteur ne clique pas.
 * C'est ce qui rend vraie la phrase « ce site ne dépose aucun traceur » de
 * la politique de confidentialité — ne pas déplacer ce chargement.
 */
const avecPartoo = partoo.scriptUrl.length > 0;
const sms = `sms:${site.telephoneLien.replace('tel:', '')}`;
---

<!-- barre d'action collée en bas, sur mobile -->
<div class="barre">
  <a href={site.telephoneLien} class="barre__tel">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path>
    </svg>
    <span>Appeler — {site.telephone}</span>
  </a>
  <button type="button" class="barre__chat js-contact" aria-expanded="false" aria-controls="panneau-contact">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.9 9.9 0 0 1-3.9-.8L3 21l1.9-4.6A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z"></path>
    </svg>
    <span>Écrire</span>
  </button>
</div>

<!-- bulle flottante, à partir du format tablette -->
<button type="button" class="bulle js-contact" aria-expanded="false" aria-controls="panneau-contact">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.9 9.9 0 0 1-3.9-.8L3 21l1.9-4.6A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z"></path>
  </svg>
  <span>Une question&nbsp;? Écrivez-moi</span>
</button>

{!avecPartoo && (
  <div class="panneau" id="panneau-contact" hidden>
    <div class="panneau__tete">
      <strong>Comment me joindre</strong>
      <button type="button" class="panneau__fermer js-fermer" aria-label="Fermer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <p class="panneau__mot">
      Décrivez-moi le problème en deux lignes — je vous dis si ça se règle au
      téléphone, à distance, ou s'il vaut mieux que je passe.
    </p>
    <a class="panneau__l panneau__l--fort" href={site.telephoneLien}>
      <span>Appeler</span><span class="panneau__val">{site.telephone}</span>
    </a>
    <a class="panneau__l" href={sms}>
      <span>Envoyer un SMS</span><span class="panneau__val">{site.telephone}</span>
    </a>
    <a class="panneau__l" href={`mailto:${site.courriel}`}>
      <span>Écrire un courriel</span><span class="panneau__val">{site.courriel}</span>
    </a>
    <p class="panneau__note">Réponse le jour même, soir et samedi compris.</p>
  </div>
)}

<script is:inline define:vars={{ url: partoo.scriptUrl, attrs: partoo.attributs, avecPartoo }}>
  (function () {
    var boutons = document.querySelectorAll('.js-contact');
    var panneau = document.getElementById('panneau-contact');
    var charge = false;

    function chargerPartoo() {
      if (charge) return;
      charge = true;
      var s = document.createElement('script');
      s.src = url;
      s.async = true;
      Object.keys(attrs || {}).forEach(function (k) { s.setAttribute(k, attrs[k]); });
      document.body.appendChild(s);
    }

    function basculer() {
      if (avecPartoo) { chargerPartoo(); return; }
      if (!panneau) return;
      var ouvert = !panneau.hidden;
      panneau.hidden = ouvert;
      boutons.forEach(function (b) { b.setAttribute('aria-expanded', String(!ouvert)); });
    }

    boutons.forEach(function (b) { b.addEventListener('click', basculer); });

    var fermer = document.querySelector('.js-fermer');
    if (fermer) fermer.addEventListener('click', basculer);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && panneau && !panneau.hidden) basculer();
    });
  })();
</script>

<style>
  .bulle {
    position: fixed;
    right: clamp(1rem, 3vw, 2.25rem);
    bottom: clamp(1rem, 3vw, 2.25rem);
    z-index: 50;
    display: none;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 1.25rem 0.8rem 1.05rem;
    border: 1px solid var(--accent-deep);
    background: var(--accent);
    color: var(--ground);
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.5);
    transition: background 0.15s ease;
  }
  .bulle:hover { background: var(--accent-hi); border-color: var(--accent-hi); }
  @media (min-width: 48rem) { .bulle { display: inline-flex; } }

  .barre {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: flex;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
    background: var(--panel);
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 48rem) { .barre { display: none; } }

  .barre__tel {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.9rem;
    padding: 0.7rem 0.75rem;
    background: var(--accent);
    color: var(--ground);
    font-family: var(--mono);
    font-size: 0.92rem;
    font-weight: 700;
  }
  .barre__chat {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.9rem;
    padding: 0.7rem 1rem;
    background: none;
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .barre__chat svg { color: var(--accent); }

  /* panneau de contact */
  .panneau {
    position: fixed;
    z-index: 55;
    right: clamp(1rem, 3vw, 2.25rem);
    bottom: calc(clamp(1rem, 3vw, 2.25rem) + 3.6rem);
    width: min(22rem, calc(100vw - 2rem));
    background: var(--panel);
    border: 1px solid var(--line-strong);
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.55);
    padding: 1.1rem 1.15rem 1rem;
  }
  @media (max-width: 47.99rem) {
    .panneau { right: 0.75rem; left: 0.75rem; width: auto; bottom: 4.6rem; }
  }
  .panneau__tete { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .panneau__fermer { background: none; border: 0; color: var(--faint); cursor: pointer; padding: 0.2rem; }
  .panneau__fermer:hover { color: var(--text); }
  .panneau__mot { color: var(--dim); font-size: 0.9rem; margin: 0.5rem 0 0.9rem; }
  .panneau__l {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 0.94rem;
    font-weight: 600;
    margin-bottom: 0.45rem;
  }
  .panneau__l:hover { border-color: var(--accent); color: var(--text); }
  .panneau__l--fort { background: var(--accent); color: var(--ground); border-color: var(--accent); }
  .panneau__l--fort:hover { background: var(--accent-hi); color: var(--ground); }
  .panneau__val { font-family: var(--mono); font-size: 0.82rem; font-weight: 400; opacity: 0.85; }
  .panneau__note { margin: 0.7rem 0 0; font-size: 0.8rem; color: var(--faint); }

  @media (max-width: 47.99rem) {
    :global(body) { padding-bottom: 4.5rem; }
  }
</style>
