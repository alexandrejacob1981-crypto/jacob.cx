---
import { site } from '../data/site';

interface Props {
  titre: string;
  texte: string;
}
const { titre, texte } = Astro.props;
---

<section class="appel">
  <div class="wrap appel__in">
    <div>
      <h2>{titre}</h2>
      <p>{texte}</p>
    </div>
    <div class="appel__actions">
      <a class="btn" href={site.telephoneLien}>Appeler {site.telephone}</a>
      <a class="courriel" href={`mailto:${site.courriel}`}>{site.courriel}</a>
    </div>
  </div>
</section>

<style>
  .appel { border-top: 1px solid var(--line); padding-block: clamp(2.25rem, 4vw, 3.25rem); }
  .appel__in {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem 2.5rem;
    justify-content: space-between;
    align-items: center;
  }
  .appel h2 { font-size: clamp(1.35rem, 2.4vw, 1.75rem); }
  .appel p { margin-top: 0.6rem; color: var(--dim); max-width: 56ch; }
  .appel__actions { display: flex; flex-direction: column; gap: 0.7rem; align-items: flex-start; }
  .courriel { font-family: var(--mono); font-size: 0.95rem; }
</style>
