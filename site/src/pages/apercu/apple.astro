---
/**
 * DIRECTION A — « Atelier », registre Apple, stack actuelle.
 *
 * Page de comparaison, hors site. Aucune dépendance ajoutée : même Astro,
 * mêmes polices déjà chargées, CSS local à la page, zéro JS.
 *
 * Registre tiré de la base ui-ux-pro-max (styles « Bento Box Grid » et
 * « Bento Grids ») : grille modulaire asymétrique, base #F5F5F7 / #FFFFFF,
 * encre #1D1D1F.
 *
 * Écart assumé : l'accent reste l'ambre #E3A93C de jacob.cx, pas le bleu
 * Apple. Sur une base neutre, l'ambre garde la marque d'Alexandre ; le bleu
 * en ferait un pastiche.
 */
import { Image } from 'astro:assets';
import otdr from '../../assets/otdr-mesure-baie.jpg';
import baie from '../../assets/baie-aruba.jpg';
import soudeuse from '../../assets/soudeuse-sumitomo.jpg';
import { site } from '../../data/site';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Direction A « Atelier » — aperçu jacob.cx</title>
  </head>
  <body>
    <div class="bandeau">
      Aperçu de direction — <b>A · Atelier</b> (registre Apple, sans dépendance)
      · <a href="/apercu/magic">direction B, Magic UI</a>
      · <a href="/">« Relevé », en ligne</a>
    </div>

    <header class="tete">
      <a class="logo" href="/">jacob.cx</a>
      <nav>
        <a href="#entreprises">Entreprises</a>
        <a href="#particuliers">Particuliers</a>
        <a href="#wifi">WiFi</a>
      </nav>
      <a class="cta" href={site.telephoneLien}>Appeler</a>
    </header>

    <main>
      <section class="hero">
        <p class="sur">Meudon · Île-de-France</p>
        <h1>Le WiFi ne « marche pas » ?<br /><em>Moi, je mesure.</em></h1>
        <p class="chapo">
          Infogérance, dépannage et réseaux WiFi. Vingt-cinq ans de terrain, et les
          appareils de mesure des techniciens opérateurs pour prouver d'où vient la panne.
        </p>
        <div class="boutons">
          <a class="b1" href={site.telephoneLien}>Appeler {site.telephone}</a>
          <a class="b2" href="#entreprises">Voir les prestations</a>
        </div>
      </section>

      <section class="bento">
        <article class="t t--large">
          <Image
            src={otdr}
            alt="Réflectomètre optique en mesure devant une baie de brassage"
            widths={[600, 900, 1300]}
            sizes="(max-width: 62rem) 92vw, 60vw"
            loading="eager"
          />
          <div class="t__texte">
            <h2>La panne a une adresse exacte.</h2>
            <p>
              Réflectométrie sur la fibre, qualification sur le cuivre. Je ne suppose
              pas : je relève, et je vous montre le relevé.
            </p>
            <dl class="mesures">
              <div><dt>Coupure localisée</dt><dd>5 380 m</dd></div>
              <div><dt>Perte de soudure</dt><dd>0,02 dB</dd></div>
              <div><dt>Lien cuivre</dt><dd>1000 Mb/s</dd></div>
            </dl>
          </div>
        </article>

        <article class="t t--accent" id="entreprises">
          <span class="t__oeil">Entreprises</span>
          <h2>Infogérance au forfait.</h2>
          <p>
            Postes, serveurs, messagerie, sauvegarde, réseau et ligne. Un seul
            interlocuteur, du poste de travail jusqu'à la prise.
          </p>
          <p class="t__prix">à partir de 29 € HT / poste / mois</p>
          <a href="/infogerance">Découvrir</a>
        </article>

        <article class="t" id="particuliers">
          <span class="t__oeil">Particuliers</span>
          <h2>Chez vous, soir et samedi.</h2>
          <p>
            Ordinateur, WiFi, photos perdues, domotique, son et vidéo. Sans supplément
            le soir et le samedi.
          </p>
          <p class="t__prix">290 € TTC — soit 145 € après crédit d'impôt</p>
          <a href="/particuliers">Voir les interventions</a>
        </article>

        <article class="t t--wide" id="wifi">
          <div>
            <span class="t__oeil">Réseaux WiFi</span>
            <h2>Une couverture mesurée avant d'être installée.</h2>
            <p>
              Commerces, cabinets, hôtels, bureaux. Audit de couverture, réseau invité
              séparé et journalisé, matériel Aruba et Ruckus.
            </p>
            <p class="t__prix">audit 290 € HT — déduit si installation</p>
            <a href="/wifi-professionnel">Découvrir le WiFi pro</a>
          </div>
          <Image
            src={baie}
            alt="Baie de brassage avec contrôleur Aruba et panneau étiqueté borne par borne"
            widths={[420, 640, 900]}
            sizes="(max-width: 62rem) 92vw, 40vw"
            loading="lazy"
          />
        </article>

        <article class="t t--sombre">
          <span class="t__oeil">En urgence</span>
          <h2>Fibre coupée dans vos locaux.</h2>
          <p>Localisation puis soudure sur place, dans la journée — ou sous quatre heures.</p>
          <a href="/expertise-telecom">En savoir plus</a>
        </article>

        <article class="t t--image">
          <Image
            src={soudeuse}
            alt="Soudeuse fibre Sumitomo en cours d'alignement"
            widths={[420, 640, 900]}
            sizes="(max-width: 62rem) 92vw, 30vw"
            loading="lazy"
          />
          <div class="t__legende">
            <h2>Je soude la fibre.</h2>
            <p>Pas seulement le diagnostic.</p>
          </div>
        </article>

        <article class="t t--chiffres">
          <div><b>25</b><span>ans de terrain</span></div>
          <div><b>0,02</b><span>dB de perte</span></div>
          <div><b>4 h</b><span>en urgence fibre</span></div>
        </article>
      </section>

      <section class="final">
        <h2>Décrivez-moi le problème en deux lignes.</h2>
        <p>
          Je vous dis si ça se règle au téléphone, à distance, ou s'il vaut mieux que
          je passe.
        </p>
        <a class="b1" href={site.telephoneLien}>Appeler {site.telephone}</a>
      </section>
    </main>

    <style>
      /* jetons : base Apple, accent jacob.cx */
      :root {
        --bg: #f5f5f7;
        --surface: #ffffff;
        --ink: #1d1d1f;
        --ink-2: #6e6e73;
        --ink-3: #86868b;
        --trait: #e3e3e6;
        --accent: #e3a93c;
        --accent-fonce: #8a6414;
        --nuit: #1d1d1f;
        --r: 22px;
        --sans: 'Archivo Variable', 'Archivo', -apple-system, system-ui, sans-serif;
        --mono: 'JetBrains Mono', ui-monospace, Consolas, monospace;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; text-decoration: none; }
      h1, h2 { margin: 0; letter-spacing: -0.035em; line-height: 1.05; text-wrap: balance; }
      p { margin: 0; }

      .bandeau {
        background: var(--nuit);
        color: #f5f5f7;
        font-size: 0.8rem;
        text-align: center;
        padding: 0.6rem 1rem;
      }
      .bandeau a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

      .tete {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 0.85rem clamp(1rem, 4vw, 3rem);
        background: rgb(245 245 247 / 0.78);
        backdrop-filter: saturate(180%) blur(20px);
        border-bottom: 1px solid var(--trait);
        font-size: 0.88rem;
      }
      .logo { font-weight: 800; font-size: 1.1rem; letter-spacing: -0.02em; }
      .tete nav { display: flex; gap: 1.75rem; margin-left: auto; color: var(--ink-2); }
      .tete nav a:hover { color: var(--ink); }
      .cta {
        background: var(--ink);
        color: #fff;
        padding: 0.5rem 1.1rem;
        border-radius: 999px;
        font-weight: 600;
      }
      @media (max-width: 46rem) {
        .tete nav { display: none; }
        .cta { margin-left: auto; }
      }

      .hero {
        text-align: center;
        padding: clamp(3.5rem, 10vw, 7.5rem) clamp(1rem, 5vw, 3rem) clamp(2.5rem, 6vw, 4rem);
        max-width: 60rem;
        margin-inline: auto;
      }
      .sur {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
        margin-bottom: 1.25rem;
      }
      h1 { font-size: clamp(2.6rem, 7.5vw, 5.25rem); font-weight: 800; }
      h1 em { font-style: normal; color: var(--accent-fonce); }
      .chapo {
        margin: 1.75rem auto 0;
        max-width: 46ch;
        font-size: clamp(1.05rem, 1.7vw, 1.3rem);
        color: var(--ink-2);
      }
      .boutons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        justify-content: center;
        margin-top: 2.25rem;
      }
      .b1, .b2 {
        padding: 0.9rem 1.75rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 1rem;
      }
      .b1 { background: var(--accent); color: var(--nuit); }
      .b1:hover { background: #f0be63; }
      .b2 { border: 1px solid var(--trait); background: var(--surface); }
      .b2:hover { border-color: var(--ink-3); }

      .bento {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: clamp(0.75rem, 1.4vw, 1.25rem);
        padding: 0 clamp(1rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem);
        max-width: 90rem;
        margin-inline: auto;
      }
      .t {
        background: var(--surface);
        border-radius: var(--r);
        padding: clamp(1.5rem, 2.4vw, 2.25rem);
        grid-column: span 2;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        overflow: hidden;
      }
      .t h2 { font-size: clamp(1.3rem, 2vw, 1.7rem); font-weight: 700; }
      .t p { color: var(--ink-2); font-size: 0.97rem; }
      .t__oeil {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .t__prix {
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--accent-fonce);
        margin-top: auto;
      }
      .t a[href^="/"] {
        font-weight: 600;
        color: var(--accent-fonce);
        border-bottom: 1.5px solid var(--accent);
        align-self: flex-start;
        padding-bottom: 1px;
      }

      .t--large { grid-column: span 4; padding: 0; }
      .t--large img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
      .t--large .t__texte {
        padding: clamp(1.5rem, 2.4vw, 2.25rem);
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }
      .mesures { display: flex; flex-wrap: wrap; gap: 1.75rem; margin: 0.5rem 0 0; }
      .mesures div { display: flex; flex-direction: column; }
      .mesures dt {
        font-size: 0.72rem;
        color: var(--ink-3);
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .mesures dd {
        margin: 0.2rem 0 0;
        font-family: var(--mono);
        font-weight: 700;
        font-size: 1.05rem;
      }

      .t--accent { background: var(--nuit); color: #f5f5f7; }
      .t--accent p, .t--accent .t__oeil { color: #a1a1a6; }
      .t--accent .t__prix { color: var(--accent); }
      .t--accent a[href^="/"] { color: var(--accent); }

      .t--wide {
        grid-column: span 6;
        flex-direction: row;
        align-items: center;
        gap: 2.5rem;
        padding-right: 0;
      }
      .t--wide > div { flex: 1 1 22rem; display: flex; flex-direction: column; gap: 0.75rem; }
      .t--wide img { flex: 1 1 20rem; align-self: stretch; object-fit: cover; min-height: 260px; }

      .t--sombre { background: #2a1512; color: #fbeae4; grid-column: span 2; }
      .t--sombre p { color: #e0b6a8; }
      .t--sombre .t__oeil { color: #e08a6e; }
      .t--sombre a[href^="/"] { color: #f0be63; border-bottom-color: #c4553a; }

      .t--image { grid-column: span 2; padding: 0; position: relative; }
      .t--image img { width: 100%; height: 100%; min-height: 240px; object-fit: cover; }
      .t--image .t__legende {
        position: absolute;
        inset: auto 0 0 0;
        padding: 1.5rem;
        background: linear-gradient(to top, rgb(29 29 31 / 0.92), transparent);
        color: #fff;
      }
      .t--image .t__legende p { color: #d2d2d7; }

      .t--chiffres {
        grid-column: span 2;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
      .t--chiffres div { display: flex; flex-direction: column; }
      .t--chiffres b {
        font-family: var(--mono);
        font-size: clamp(1.3rem, 2.4vw, 1.9rem);
        letter-spacing: -0.02em;
      }
      .t--chiffres span { font-size: 0.72rem; color: var(--ink-3); margin-top: 0.25rem; }

      @media (max-width: 62rem) {
        .bento { grid-template-columns: repeat(2, 1fr); }
        .t, .t--large, .t--sombre, .t--image, .t--chiffres { grid-column: span 2; }
        .t--wide {
          grid-column: span 2;
          flex-direction: column;
          align-items: stretch;
          padding-right: clamp(1.5rem, 2.4vw, 2.25rem);
        }
        .t--wide img { min-height: 220px; border-radius: 14px; }
      }
      @media (max-width: 40rem) {
        .bento { grid-template-columns: 1fr; }
        .t, .t--large, .t--wide, .t--sombre, .t--image, .t--chiffres { grid-column: span 1; }
        .t--chiffres { flex-direction: column; align-items: flex-start; gap: 1rem; }
      }

      .final {
        text-align: center;
        padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 5vw, 3rem);
        max-width: 46rem;
        margin-inline: auto;
      }
      .final h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; }
      .final p { margin: 1rem auto 2rem; color: var(--ink-2); max-width: 44ch; }

      :focus-visible {
        outline: 2px solid var(--accent-fonce);
        outline-offset: 3px;
        border-radius: 6px;
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </body>
</html>
